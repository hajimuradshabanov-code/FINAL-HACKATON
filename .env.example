# Copy to .env and adjust. Never commit .env.
# nasa (default: training simulation on real NASA data) | live (NASA feeds only, no vitals) | sim | ws
VITE_DATA_SOURCE=nasa
# Personal key from https://api.nasa.gov (DEMO_KEY is used when empty)
VITE_NASA_API_KEY=
# Only for VITE_DATA_SOURCE=ws
VITE_WS_URL=ws://localhost:8080/telemetry

# ---- AI assistant (Google Gemini) — SERVER-SIDE ONLY ----
# No VITE_ prefix on purpose: these stay on the server (/api/assistant) and are never bundled
# into the website. Create a key at https://aistudio.google.com/apikey
# On Vercel set them in Project -> Settings -> Environment Variables, then redeploy.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
